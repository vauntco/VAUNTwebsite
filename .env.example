# Vaunt site environment variables.
# Copy to ".env" locally (or set in Railway "Variables") and fill in real values.

# GoHighLevel inbound-webhook URL for the single "Website > Contact us Form"
# workflow. ALL three site forms (contact, hero quick-start, newsletter) POST
# here; the workflow tells them apart via the "Form Type" field.
# Until set, forms show a friendly success message without sending.
VITE_GHL_WEBHOOK_URL=
