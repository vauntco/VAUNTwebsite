# Vaunt site environment variables.
# Copy to ".env" locally (or set in Replit "Secrets") and fill in real values.

# GoHighLevel inbound webhook / form endpoint the Contact form POSTs to.
# Until set, the contact form shows a friendly success message without sending.
VITE_GHL_WEBHOOK_URL=

# GoHighLevel endpoint the Newsletter form POSTs to (email only).
VITE_GHL_NEWSLETTER_URL=
