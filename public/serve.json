{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/post/**", "destination": "/blog/index.html" },
    { "source": "/author/**", "destination": "/about/index.html" },
    { "source": "/portfolio/**", "destination": "/work/index.html" },
    { "source": "/testimonials/**", "destination": "/testimonials/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
